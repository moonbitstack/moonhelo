// Starting and stopping: the app's lifespan hooks, a drained gRPC connection,
// and a run that stops between two nodes and continues from its checkpoint.
supported_targets = "native"

pkgtype(kind: "executable")

import {
  "moonbitstack/moonapi",
  "moonbitstack/moonrpc",
  "moonbitstack/moonstate",
  "moonbitstack/moonasgi/testing",
  "moonbitlang/async",
  "moonbitlang/core/json",
}

// The assembled greet service: moonapi routing with a request-id middleware,
// wrapped by a moonzero Server that adds go-zero-style request logging, wired to
// a moonorm Session over a real SQLite database (moonsqlite), and served by
// mooncat. The mctl-generated User model (genmodel) is the persistence layer, so
// a request round-trips through the same declarative model the spec produced.
// Native-only: it serves over async HTTP and links SQLite through FFI.
supported_targets = "native"

import {
  "moonbitstack/moonapi",
  "moonbitstack/moonasgi",
  "moonbitstack/moonzero" @zero,
  "moonbitstack/moonorm",
  "moonbitstack/moondb",
  "moonbitstack/moonsqlite" @sqlite,
  "moonbitstack/mooncat",
  "moonbitstack/moongql" @gql,
  "moonbitstack/moonjson",
  "moonbitstack/moonhelo/genmodel",
  "moonbitlang/core/encoding/utf8",
}

// The end-to-end tests drive the running server with a real async HTTP client,
// and write their database to the system temporary directory.
import {
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/core/env",
} for "test"

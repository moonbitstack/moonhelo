// The moonorm data layer mctl generates from greet.api's `type User` block: the
// `#orm.table` struct in `models.mbt` and its migrations in `migrate.mbt`, both
// written by `moon run src/gen`; the build expands the annotations into
// `models.g.mbt`. All three are committed so the repository shows what each step
// produces.
import {
  "moonbitstack/moonorm",
  "moonbitstack/moondb",
}

dev_build(rule: "orm", input: "models.mbt", output: "models.g.mbt")

formatter(ignore: [ "models.g.mbt" ])

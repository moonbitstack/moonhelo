// The moonapi scaffold mctl generates from greet.api's service block: a
// `build_app` that wires each route to a handler, plus one handler stub per
// route. Regenerated by `moon run gen`; committed so the repo shows what mctl
// emits. It compiles against the published moonapi + moonasgi, which is the "the
// generator's output builds" half of the DoD.
import {
  "Lfan-ke/moonapi",
  "Lfan-ke/moonasgi",
}
